#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
# Preserve EasyADB's fixed file.exec command and its original argument surface.
set -eu
[ "$#" -eq 1 ] || { printf '%s\n' '只允许 scan 或 last' >&2; exit 1; }
case "$1" in
    scan|last) exec /usr/libexec/luci-easy-discovery-adb "$1" ;;
    *) printf '%s\n' '不支持的发现操作' >&2; exit 1 ;;
esac
