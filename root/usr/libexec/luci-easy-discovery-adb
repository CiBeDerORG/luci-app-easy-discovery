#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu
ED_KIND=adb
. /usr/share/easy-discovery/discovery/common.sh
ed_init
[ "$#" -eq 1 ] || ed_error invalid_arguments '仅接受一个固定发现操作'
case "$1" in
    list) exec ucode "$ED_FORMAT" list "$ED_SNAPSHOT" adb ;;
    last)
        [ -s "$ED_SNAPSHOT" ] || ed_error no_snapshot '尚无 ADB 发现快照'
        exec ucode "$ED_FORMAT" list "$ED_SNAPSHOT" adb ;;
    scan) ;;
    *) ed_error invalid_arguments '不支持的 ADB 发现操作' ;;
esac
[ -x /usr/bin/avahi-browse ] || ed_error dependency_missing '请先安装 avahi-utils'
pidof avahi-daemon >/dev/null 2>&1 || ed_error service_stopped 'Avahi 服务未运行'
ed_begin
ed_scope
ucode "$ED_FORMAT" ifaces "$ED_WORK" > "$ED_WORK/ifaces" 2>/dev/null || ed_error scope_unavailable '无法读取发现接口'
index=0
while IFS= read -r iface; do
    case "$iface" in *[!A-Za-z0-9_.:-]*|-*|'') continue ;; esac
    index=$((index + 1))
    [ "$index" -le 8 ] || break
    ed_capture "$ED_WORK/adb-$index" timeout 8 avahi-browse -i "$iface" -rpt _adb-tls-connect._tcp &
    ED_CHILDREN="$ED_CHILDREN $!"
done < "$ED_WORK/ifaces"
wait
ED_CHILDREN=
[ "$index" -gt 0 ] || ed_error scope_unavailable '没有可以发现的本地网络接口'
for rcfile in "$ED_WORK"/adb-*.rc; do
    rc=$(cat "$rcfile")
    [ "$rc" -eq 0 ] || [ "$rc" -eq 124 ] || ed_error browse_failed '部分接口的 Avahi 发现失败，已保留上次成功结果'
done
ed_publish
