#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu
ED_KIND=adb
. /usr/share/easy-discovery/discovery/common.sh
ed_init
[ "$#" -eq 1 ] || ed_error invalid_arguments '仅接受一个固定发现操作'
case "$1" in
    list) exec ucode "$ED_FORMAT" list "$ED_SNAPSHOT" adb ;;
    last)
        [ -s "$ED_SNAPSHOT" ] || ed_error no_snapshot '尚无 ADB 发现快照'
        exec ucode "$ED_FORMAT" list "$ED_SNAPSHOT" adb ;;
    scan) ;;
    *) ed_error invalid_arguments '不支持的 ADB 发现操作' ;;
esac
[ -x /usr/bin/avahi-browse ] || ed_error dependency_missing '请先安装 avahi-utils'
pidof avahi-daemon >/dev/null 2>&1 || ed_error service_stopped 'Avahi 服务未运行'
ed_begin
ed_scope
# Output still passes the strict interface and subnet checks in format.uc.
ed_browse "$ED_WORK/adb" 8 adb &
ED_CHILDREN="$!"
wait
ED_CHILDREN=
rc=$(cat "$ED_WORK/adb.rc" 2>/dev/null || printf '1')
case "$rc" in
    0|124) ;;
    *) ed_browse_error "$ED_WORK/adb" ;;
esac

ed_publish
