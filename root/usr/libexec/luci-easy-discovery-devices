#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -eu
ED_KIND=devices
. /usr/share/easy-discovery/discovery/common.sh
ed_init
[ "$#" -eq 1 ] || ed_error invalid_arguments '仅接受一个固定发现操作'
case "$1" in
    list) exec ucode "$ED_FORMAT" list "$ED_SNAPSHOT" devices ;;
    scan) ;;
    *) ed_error invalid_arguments '不支持的设备发现操作' ;;
esac
ed_begin
ed_scope
ed_capture "$ED_WORK/host-hints" timeout 3 ubus -t 2 call luci-rpc getHostHints &
ED_CHILDREN="$ED_CHILDREN $!"
ed_capture "$ED_WORK/leases" timeout 3 ubus -t 2 call luci-rpc getDHCPLeases &
ED_CHILDREN="$ED_CHILDREN $!"
ed_capture "$ED_WORK/neighbors4" timeout 2 ip -4 neigh show &
ED_CHILDREN="$ED_CHILDREN $!"
ed_capture "$ED_WORK/neighbors6" timeout 2 ip -6 neigh show &
ED_CHILDREN="$ED_CHILDREN $!"
if [ -x /usr/bin/avahi-browse ] && pidof avahi-daemon >/dev/null 2>&1; then
    ucode "$ED_FORMAT" ifaces "$ED_WORK" > "$ED_WORK/mdns-ifaces" 2>/dev/null || ed_error scope_unavailable '无法读取发现接口'
    _ed_mdns_index=0
    while IFS= read -r _ed_iface; do
        case "$_ed_iface" in *[!A-Za-z0-9_.:-]*|-*|'') continue ;; esac
        _ed_mdns_index=$((_ed_mdns_index + 1))
        [ "$_ed_mdns_index" -le 8 ] || break
        ed_capture "$ED_WORK/mdns-$_ed_mdns_index" timeout 3 avahi-browse -i "$_ed_iface" -arpt &
        ED_CHILDREN="$ED_CHILDREN $!"
    done < "$ED_WORK/mdns-ifaces"
fi
wait
ED_CHILDREN=
# Native DHCP lease retrieval normally handles alternative lease files. The
# common dnsmasq file is a fallback if luci-rpc is temporarily unavailable.
if [ -r /tmp/dhcp.leases ] && [ ! -L /tmp/dhcp.leases ]; then
    ed_capture "$ED_WORK/dhcp-file" head -c 262144 /tmp/dhcp.leases
fi
if [ "$(cat "$ED_WORK/arp-enabled")" = 1 ]; then
    if command -v arp-scan >/dev/null 2>&1; then
        ucode "$ED_FORMAT" arp-plan "$ED_WORK" > "$ED_WORK/arp-plan" 2>/dev/null ||
            ed_error scope_unavailable '无法生成受限 ARP 发现范围'
        _ed_index=0
        while IFS=' ' read -r _ed_iface _ed_cidr; do
            [ -n "$_ed_iface" ] && [ -n "$_ed_cidr" ] || continue
            # Both tokens are derived by the formatter from validated network
            # state, and checked again before constructing an argument vector.
            case "$_ed_iface" in *[!A-Za-z0-9_.:-]*|-*|'') continue ;; esac
            case "$_ed_cidr" in *[!0-9./]*|'') continue ;; esac
            _ed_index=$((_ed_index + 1))
            [ "$_ed_index" -le 2 ] || break
            printf '%s\n' "$_ed_iface" > "$ED_WORK/arp-$_ed_index.iface"
            ed_capture "$ED_WORK/arp-$_ed_index" timeout 4 arp-scan --interface="$_ed_iface" --plain --quiet --numeric --retry=1 --timeout=300 --interval=2 "$_ed_cidr" &
            ED_CHILDREN="$ED_CHILDREN $!"
        done < "$ED_WORK/arp-plan"
        wait
        ED_CHILDREN=
    else
        printf '127\n' > "$ED_WORK/arp-missing.rc"
    fi
fi
ed_publish
